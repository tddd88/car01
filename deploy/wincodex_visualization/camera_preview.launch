<launch><group ns="wincodex_visualization/camera">
<node pkg="usb_cam" type="usb_cam_node" name="usb_cam" output="screen">
<param name="video_device" value="/dev/v4l/by-id/usb-LRCP_FHD1080P_USB_2.0_Camera-video-index0"/>
<param name="pixel_format" value="mjpeg"/><param name="image_width" value="320"/><param name="image_height" value="240"/><param name="framerate" value="15"/><param name="camera_frame_id" value="camera"/>
</node></group></launch>
