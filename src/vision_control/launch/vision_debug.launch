<launch>
    <!-- 默认只看蓝色叠框画面。run_servo=true 也仅发布视觉输入，不能直通底盘。 -->
    <arg name="run_servo" default="false" />
    <arg name="image_topic" default="/usb_cam/image_raw" />
    <include file="$(find vision_control)/launch/vision.launch">
        <arg name="run_servo" value="$(arg run_servo)" />
        <arg name="image_topic" value="$(arg image_topic)" />
    </include>
</launch>
