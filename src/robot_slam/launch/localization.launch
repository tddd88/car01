<launch>
    <!-- 请在启动前确认地图文件是否已准备好，可以在命令行传参 pbstream:=/path/to/map.pbstream -->
    <arg name="pbstream" default="$(find robot_slam)/map/map.pbstream" />

    <!-- 启动 cartographer 节点进行纯定位 -->
    <!-- 2026-10-25 ZCode: start_trajectory_with_default_topics 改回 true。
         Cartographer 自己在原点(=建图起始点)启动定位轨迹, 不再依赖
         initial_pose_loader 注入建图退出位姿(该路径多次拒绝启动, 已弃用)。 -->
    <node name="cartographer_node" pkg="cartographer_ros"
        type="cartographer_node" args="
            -configuration_directory $(find robot_slam)/config
            -configuration_basename localization.lua
            -load_state_filename $(arg pbstream)
            -load_frozen_state true
            -start_trajectory_with_default_topics true"
        output="screen">
        <remap from="odom" to="odom_raw" />
    </node>

    <!-- 生成占据栅格地图 -->
    <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
        type="cartographer_occupancy_grid_node" args="-resolution 0.05" />

    <!-- 定位就绪门禁: 默认模式(inject_pose=false)只等 Cartographer 的
         默认轨迹(原点=建图起始点)变 ACTIVE 后发布 /localization/ready,
         供比赛状态机放行; 不读 bundle/last_pose, 不碰轨迹。
         如需恢复"建图退出点注入", 传 inject_pose:=true 并恢复
         -start_trajectory_with_default_topics false。 -->
    <node pkg="robot_bringup" type="initial_pose_loader.py"
          name="initial_pose_loader" output="screen">
        <param name="inject_pose" value="false" />
    </node>

</launch>
