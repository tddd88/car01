<launch>
    <arg name="start_joystick" default="true" />
    <arg name="enable_laser_safety" default="true" />
    <!-- 2026-10-25 ZCode: 摄像头开关。建图不需要视觉(bringup_mapping 传 false,
         还能省出 USB 供电/带宽); 导航两入口(nav_test/bringup_localization)保持默认 true。 -->
    <arg name="start_camera" default="true" />
    <!-- 基础硬件统一出口：所有模式先仲裁，再经过同一个雷达安全节点。 -->
    <include file="$(find robot_bringup)/launch/stm32_bridge.launch" />
    <include file="$(find lidar)/launch/lidar_scan.launch" />
    <param name="robot_description" textfile="$(find simulation)/urdf/simulation.urdf" />
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    <include file="$(find robot_bringup)/launch/joystick.launch" if="$(arg start_joystick)" />

    <node pkg="robot_bringup" type="cmd_vel_arbiter_node" name="cmd_vel_arbiter_node" output="screen">
        <param name="enable_button" value="5" />
        <param name="joy_timeout" value="0.5" />
        <param name="auto_timeout" value="0.3" />
    </node>

    <!-- 雷达安全避障：建图时默认关闭（手柄直通），导航时默认开启。
         关闭时 arbiter 输出直连 cmd_vel，跳过安全节点。 -->
    <node pkg="robot_bringup" type="laser_safety_node" name="laser_safety_node" output="screen"
          if="$(arg enable_laser_safety)">
        <param name="cmd_vel_in" value="/cmd_vel_requested" />
        <param name="cmd_vel_out" value="/cmd_vel" />
        <param name="scan_topic" value="/scan" />
        <param name="base_frame" value="base_link" />
        <param name="footprint_half_length" value="0.175" />
        <param name="footprint_half_width" value="0.11" />
        <param name="safety_margin" value="0.025" />
        <param name="scan_timeout" value="0.4" />
        <!-- 加速度限制设为极大值，实际不限制（安全节点参数校验要求 >0） -->
        <param name="max_accel_x" value="10.0" />
        <param name="max_accel_y" value="10.0" />
        <param name="max_accel_yaw" value="10.0" />
        <!-- 速度上限也放宽到接近手柄极限，避免安全节点二次限速
             2026-10-25 ZCode: max_vx 1.5 -> 1.8 与 TEB max_vel_x 对齐(节点校验上限 2.0) -->
        <param name="max_vx" value="1.8" />
        <param name="max_vy" value="1.5" />
        <param name="max_wz" value="2.5" />
    </node>

    <!-- 关闭雷达安全时：arbiter 输出（TwistStamped）relay 到 /cmd_vel_auto_stamped，
         stm32_bridge 已支持订阅该话题（TwistStamped 类型） -->
    <node pkg="topic_tools" type="relay" name="cmd_vel_passthrough"
          if="$(eval not enable_laser_safety)"
          args="/cmd_vel_requested /cmd_vel_auto_stamped" />

    <!-- 保留用户已验收的调试视频采集参数。
         respawn: 摄像头 USB 供电不稳时会枚举失败/中途掉线(实测 exit code 1),
         加 respawn 让设备回来后自动重连, 视觉链路自愈。 -->
    <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen"
          if="$(arg start_camera)" respawn="true" respawn_delay="5">
        <param name="video_device" value="/dev/video0" />
        <param name="pixel_format" value="mjpeg" />
        <param name="image_width" value="320" />
        <param name="image_height" value="240" />
        <param name="framerate" value="15" />
        <param name="camera_frame_id" value="camera" />
    </node>
</launch>
