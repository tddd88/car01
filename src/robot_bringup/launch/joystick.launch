<launch>
    <!-- 手柄遥控入口（可被其他 launch include）：
         默认输出 cmd_vel_raw，由 bringup.launch 中的 laser_safety_node 过滤后发 cmd_vel
         bringup_auto.launch 传 cmd_vel_topic=cmd_vel 直通（无避障） -->

    <arg name="cmd_vel_topic" default="cmd_vel_raw" />

    <!-- 启动手柄节点 -->
    <node pkg="joy" type="joy_node" name="joystick">
        <param name="dev" value="/dev/input/js0" />
        <!-- 强制周期发送（Hz），避免 systemd 环境下 joy_node 不触发事件导致 /joy 无数据 -->
        <param name="autorepeat_rate" value="10.0" />
        <!-- 允许 joy_node 失败后自动重启（USB 接触不好时） -->
        <param name="coalesce_interval" value="0.05" />
    </node>

    <!-- 启动手柄控制节点 (麦轮全向移动版，持续发送)
         左摇杆前后->vx, 左摇杆左右->vy, 右摇杆左右->vth
         只要使能键按住，就按 autorepeat_rate 持续下发速度 -->
    <node pkg="robot_bringup" type="joy_repeat_node" name="teleop_twist_joy">
        <remap from="cmd_vel" to="$(arg cmd_vel_topic)" />
        <!-- 使能键 R1 (Button 5, X-Box 360 pad) -->
        <param name="enable_button" value="5" />
        <!-- 轴映射: axis1=左摇杆前后(vx), axis0=左摇杆左右(vy), axis3=右摇杆左右(vth) -->
        <param name="axis_vx" value="1" />
        <param name="axis_vy" value="0" />
        <param name="axis_vth" value="3" />
        <!-- 速度限制配置 -->
        <param name="scale_vx" value="0.8" />
        <param name="scale_vy" value="0.5" />
        <param name="scale_vth" value="0.5" />
        <!-- 持续发送频率 -->
        <param name="autorepeat_rate" value="20.0" />
    </node>

    <!-- 麦轮横移漂移补偿节点（暂时禁用，测 32 期间直通）
    <node pkg="robot_bringup" type="chassis_corrector_node" name="chassis_corrector" output="screen">
        <rosparam>
            cmd_vel_in: cmd_vel_raw
            cmd_vel_out: cmd_vel
            odom_topic: odom_raw
            kp_vx: 0.8
            kp_vth: 0.8
            deadband_vx: 0.02
            deadband_vth: 0.05
            filter_alpha: 0.3
            strafe_activate: 0.05
            publish_rate: 20.0
            cmd_timeout: 0.5
        </rosparam>
    </node>
    -->
</launch>
