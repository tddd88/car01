<launch>
    <!-- V4.1 全自动比赛总入口：硬件 + 定位 + 导航 + 视觉 + 决策 -->

    <!-- 1. 底层硬件、TF、雷达、摄像头 -->
    <include file="$(find robot_bringup)/launch/bringup.launch" />

    <!-- 2. Cartographer 纯定位（加载已建图 pbstream） -->
    <arg name="pbstream" default="$(find robot_slam)/map/map.pbstream" />
    <include file="$(find robot_slam)/launch/localization.launch">
        <arg name="pbstream" value="$(arg pbstream)" />
    </include>

    <!-- 3. 导航 move_base（TEB，输出 /cmd_vel_nav） -->
    <include file="$(find navigation)/launch/move_base.launch" />

    <!-- 4. 视觉控制（蓝纸检测 + 伺服，输出 /cmd_vel_vision） -->
    <include file="$(find vision_control)/launch/vision.launch" />

    <!-- 5. 决策状态机 + 预备点保存（总控 /cmd_vel） -->
    <include file="$(find decision)/launch/race.launch" />
</launch>
