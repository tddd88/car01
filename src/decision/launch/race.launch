<launch>
    <!-- 决策：比赛状态机 + 预备点保存 -->

    <arg name="active_file" default="$(find robot_slam)/map/bundles/active.yaml" />
    <!-- 严格加载与 active 地图同版本的预备点；缺失/损坏时不发布。 -->
    <node pkg="robot_bringup" type="waypoints_saver.py" name="waypoints_saver" output="screen">
        <param name="button_idx" value="1" />
        <param name="save_dir" value="$(find robot_slam)/map" />
        <param name="load_active_bundle" value="true" />
        <param name="active_file" value="$(arg active_file)" />
    </node>

    <!-- 比赛状态机（导航 -> 视觉伺服 -> 盲搜） -->
    <node pkg="decision" type="race_state_machine_node" name="race_state_machine" output="screen">
        <rosparam>
            auto_start: true
            allow_visual_during_navigation: false
            readiness_timeout: 0.5
            nav_cmd_timeout: 0.5
            vision_cmd_timeout: 0.3
            target_timeout: 0.3
            goal_timeout: 120.0
            search_speed: 0.20
            <!-- P1-5: 0.20 rad/s * 20s = 4.0rad ≈ 229°，转不满一圈，纸在车后侧永远搜不到。
                 35s -> 7.0rad > 360°，保证能扫满一圈。 -->
            search_max_time: 35.0
            search_max_angle: 6.3
            <!-- P1-5: 2 次很容易被一次抖动耗光直接进终态，放宽到 5。 -->
            search_max_attempts: 5
            target_stable_time: 0.4
            reached_stable_time: 0.8
            <!-- P1-3: VISUAL 稳态判据久不成立时的兜底。
                 visual_standoff 必须与 vision.launch 的 standoff_distance 一致。 -->
            visual_max_time: 25.0
            visual_standoff: 0.45
            visual_park_window: 0.15
        </rosparam>
    </node>
</launch>
